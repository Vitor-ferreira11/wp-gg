# Somente servidor. Nunca use NEXT_PUBLIC_RIOT_API_KEY.
RIOT_API_KEY=
# Opcional: true habilita a versão pública demonstrativa, sem Riot API e SQLite.
# Na Vercel, este modo é sempre ativado automaticamente.
# WP_DEMO_ONLY=true
# Opcional: disabled desativa toda leitura/escrita SQLite. Padrão local: ativo.
# Na Vercel, a persistência local é sempre desativada automaticamente.
# WP_PERSISTENCE=disabled
# Opcional: arquivo SQLite em armazenamento persistente.
# WP_DATABASE_PATH=.data/wp-gg.sqlite
